{
  "compilerOptions": {
    "rootDir": "./src",
    "lib": ["esnext"],
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "ES2021"
  },
  "references": [],
  "include": ["src/**/*.ts"],
  // Type tests augment Canonical.Kinds
  "exclude": ["node_modules", "src/**/*.test-d.ts"]
}
